{
  "name": "cookie",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server/*"
  ],
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun --filter ./apps/web typecheck && bun --filter ./apps/android typecheck",
    "test": "vitest run",
    "build:web": "bun --filter ./apps/web build",
    "build:worker": "bun --filter ./server/api build",
    "build:android": "bun --filter ./apps/web build && bun --filter ./apps/android sync"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "^4.149.0"
  }
}
