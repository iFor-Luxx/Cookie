# Cookie — env template. Copiar a .env (gitignored). Nunca commitear secretos.

# API base para dev local
COOKIE_API_URL=http://localhost:8787
VITE_API_URL=http://localhost:8787
VITE_PROTOCOL_VERSION=1

# Cloudflare (solo staging/prod, vía dashboard/CI, no aquí)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Firebase/FCM (solo Android push, H6)
# FCM_SERVER_KEY=
