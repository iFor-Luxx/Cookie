{
  "name": "cookie-dev",
  "compatibility_date": "2026-10-01",
  "main": "../../server/api/src/worker.ts",
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,capacitor://localhost,https://localhost"
  },
  // Secretos SOLO vía `wrangler secret put` (nunca aquí):
  // ACCESS_SECRET (>=32 bytes), INTERNAL_SECRET
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cookie-dev",
      "migrations_dir": "../../server/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "cookie-dev" }],
  "durable_objects": {
    "bindings": [{ "name": "PAIR_ROOM", "class_name": "PairRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PairRoom"] }]
}
