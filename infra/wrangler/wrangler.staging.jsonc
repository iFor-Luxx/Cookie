{
  "name": "cookie-staging",
  "compatibility_date": "2026-10-01",
  "main": "../../server/api/src/worker.ts",
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175,capacitor://localhost,https://localhost",
    "API_BASE": "https://cookie-staging.ifor-dev.workers.dev"
  },
  // Secretos SOLO vía `wrangler secret put --env staging`:
  // ACCESS_SECRET (>=32 bytes), INTERNAL_SECRET,
  // FCM_SERVICE_ACCOUNT (JSON de cuenta de servicio; opcional, sin él no hay push).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cookie-staging",
      "database_id": "9d2e356f-1229-4143-a3a2-a7e3e12eb6d1",
      "migrations_dir": "../../server/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "cookie-staging" }],
  "durable_objects": {
    "bindings": [{ "name": "PAIR_ROOM", "class_name": "PairRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PairRoom"] }],
  "triggers": { "crons": ["0 4 * * *"] }
}
