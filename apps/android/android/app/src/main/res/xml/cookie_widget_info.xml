<?xml version="1.0" encoding="utf-8"?>
<!-- H6: sin updatePeriodMillis (0 = solo por eventos/app). El polling agresivo
     está prohibido por producto: FCM + WorkManager + reconciliación al abrir. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="180dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/cookie_widget"
    android:description="@string/widget_desc"
    android:previewLayout="@layout/cookie_widget"
    android:widgetCategory="home_screen"
    android:resizeMode="horizontal|vertical" />
